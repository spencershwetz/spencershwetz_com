---
const name = "Spencer Schweitz";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name}</title>
  </head>
  <body>
    <main>
      <h1>{name}</h1>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #111;
    background: #fff;
    font-family: system-ui, sans-serif;
  }

  main {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 8vw, 5rem);
    font-weight: 600;
  }
</style>
