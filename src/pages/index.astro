---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { HOME, SITE, SOCIALS } from "@consts";

const apps = [
  { name: "ATC Tower Trainer", href: "https://atctowertrainer.com", description: "Realistic phraseology and tower scenarios for aspiring air traffic controllers." },
  { name: "ATC Toolkit", href: "https://atctoolkit.com", description: "FAA facility, staffing, pay, and career information in one practical reference." },
  { name: "False Color Viewer", href: "https://falsecolorapp.com", description: "Compare exposure maps and understand false color before the camera rolls." },
  { name: "LUT Designer", href: "https://lutdesigner.com", description: "Design color transforms on iPhone and export production-ready .cube LUTs." },
  { name: "Markdown Voice Memos", href: "https://markdownvoicememos.com", description: "Private, on-device voice transcription that produces clean Markdown notes." },
  { name: "Apple Deal Tracker", href: "https://appledealtracker.com", description: "Track Apple product prices and find meaningful discounts without the noise." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Spencer Shwetz",
  url: "https://spencershwetz.com",
  jobTitle: "Independent iOS Developer",
  sameAs: SOCIALS.map((social) => social.HREF),
  knowsAbout: ["iOS development", "Swift", "filmmaking tools", "air traffic control training", "color grading"],
};
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Container>
    <div class="space-y-16">
      <section class="animate space-y-5" aria-labelledby="intro-heading">
        <p class="text-sm font-semibold uppercase tracking-widest opacity-70">Independent iOS developer</p>
        <h1 id="intro-heading" class="text-4xl font-semibold leading-tight text-black dark:text-white sm:text-5xl">
          I build focused tools for people doing demanding work.
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed">
          I'm Spencer Shwetz. My apps help filmmakers judge exposure and design LUTs, aspiring controllers practice aviation, and busy people turn ideas into useful notes.
        </p>
        <p><Link href="#apps">Explore the apps</Link></p>
      </section>

      <section id="apps" class="animate space-y-6" aria-labelledby="apps-heading">
        <h2 id="apps-heading" class="text-2xl font-semibold text-black dark:text-white">Apps and tools</h2>
        <ul class="divide-y divide-black/10 dark:divide-white/10">
          {apps.map((app) => (
            <li class="py-6 first:pt-0">
              <h3 class="text-xl font-semibold text-black dark:text-white">
                <Link href={app.href} external>{app.name}</Link>
              </h3>
              <p class="mt-2 max-w-2xl">{app.description}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="contact" class="animate space-y-4" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="text-2xl font-semibold text-black dark:text-white">Get in touch</h2>
        <p>Have a question about an app, a partnership, or a project? Email me or find me online.</p>
        <ul class="flex flex-wrap gap-x-3 gap-y-2">
          {SOCIALS.map((social) => <li><Link href={social.HREF} external>{social.NAME}</Link></li>)}
          <li><Link href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</Link></li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
